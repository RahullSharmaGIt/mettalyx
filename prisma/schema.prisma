// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OEM
  VENDOR
}

enum VendorStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum JobStatus {
  PENDING_REVIEW  // Uploaded by OEM
  OPEN            // Approved by Admin, ready for assignment
  ASSIGNED        // Assigned to Vendor
  IN_PROGRESS     // Vendor started work
  QC              // Quality Check
  COMPLETED       // Job done
  PAID            // Offline payment confirmed
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String    // Hashed
  name          String?
  companyName   String?
  role          UserRole  @default(OEM)
  createdAt     DateTime  @default(now())
  
  vendorProfile VendorProfile?
  jobsCreated   Job[]     @relation("JobCreator")
  jobsAssigned  Job[]     @relation("JobVendor")
  bids          Bid[]
  fileAccessLogs FileAccessLog[]

  @@map("users")
}

model VendorProfile {
  id                  String       @id @default(cuid())
  userId              String       @unique
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  status              VendorStatus @default(PENDING)
  companyName         String?
  contactPhone        String?
  contactEmail        String?
  gstNumber           String?
  address             String?
  city                String?
  lat                 Float?
  lng                 Float?            
  yearsOfExperience   Int?
  industriesServed    Json?        // e.g., ["Automotive", "Aerospace"]
  isAgreementAccepted Boolean      @default(false)
  
  verifiedAt          DateTime?
  isOnboarded         Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @default(now()) @updatedAt

  certifications      VendorCertification[]
  capabilities        VendorCapability?
  documents           VendorDocument[]

  @@map("vendor_profiles")
}

model VendorCertification {
  id             String        @id @default(cuid())
  vendorId       String
  vendorProfile  VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name           String        
  certificateUrl String
  issuedBy       String?
  issuedDate     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([vendorId])
  @@map("vendor_certifications")
}

model VendorCapability {
  id                  String        @id @default(cuid())
  vendorId            String        @unique
  vendorProfile       VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  capabilities        String[]      // e.g., ["CNC Machining", "Laser Cutting"]
  expertiseLevel      String?       // "Beginner", "Intermediate", "Advanced"
  tolerancesSupported String?
  maxPartSize         String?
  minPartSize         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@map("vendor_capabilities")
}

model VendorDocument {
  id             String        @id @default(cuid())
  vendorId       String
  vendorProfile  VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name           String
  url            String
  type           String        // e.g., "ISO_CERTIFICATE", "SAMPLE_WORK", "COMPLIANCE_PROOF"
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([vendorId])
  @@map("vendor_documents")
}
  
model Job {
  id          String    @id @default(cuid())
  title       String    // e.g., "CNC Machining - Steel Part X"
  description String?
  
  // Requirements
  material      String
  materialGrade String?   // e.g., SS304, 6061-T6, EN8
  quantity      Int
  tolerance     String?
  surfaceFinish String?   // e.g., Anodized, Powder Coated, Brushed
  deadline      DateTime
  location    String    // City/Pincode
  lat         Float?
  lng         Float?
  
  // Status
  status      JobStatus @default(PENDING_REVIEW)
  
  // Relations
  oemId       String
  oem         User      @relation("JobCreator", fields: [oemId], references: [id])
  
  vendorId    String?
  vendor        User?          @relation("JobVendor", fields: [vendorId], references: [id])
  files         JobFile[]
  logs          JobStatusLog[]
  bids          Bid[]
  fileAccessLogs FileAccessLog[]

  targetVendorPrice Float?         // Target price set by Admin when approving
  minPriceFloor     Float?         // Minimum allowed bid set by Admin

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([oemId])
  @@index([vendorId])
  @@index([status])
  @@map("jobs")
}

model Bid {
  id               String   @id @default(cuid())
  vendorId         String
  jobId            String
  proposedPrice    Float
  proposedLeadTime Int
  notes            String?  @db.Text
  status           BidStatus @default(PENDING)
  
  updateCount      Int      @default(0)
  isLocked         Boolean  @default(false)
  unlockRequested  Boolean  @default(false)

  rejectionReason  BidRejectionReason?
  adminFeedback    String?  @db.Text

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  vendor           User     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  job              Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([vendorId, jobId]) // One bid per vendor per job
  @@index([jobId])
  @@map("bids")
}

enum BidRejectionReason {
  PRICE
  LEAD_TIME
  GENERAL
}

model FileAccessLog {
  id          String   @id @default(cuid())
  userId      String
  fileId      String
  jobId       String
  ipAddress   String?
  accessedAt  DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model JobFile {
  id           String   @id @default(cuid())
  fileKey      String   @unique  // S3 object key — NEVER sent to client
  originalName String            // User-facing display name
  mimeType     String?
  size         Int?              // bytes
  uploadedBy   String            // userId of uploader
  jobId        String?           // Null for DRAFT files (uploaded before job created)
  job          Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([jobId])
  @@index([uploadedBy])
  @@map("job_files")
}

model JobStatusLog {
  id        String    @id @default(cuid())
  jobId     String
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status    JobStatus
  note      String?
  changedBy String    // userId (admin/vendor)
  createdAt DateTime  @default(now())

  @@index([jobId])
  @@map("job_status_logs")
}

enum BidStatus {
  PENDING
  REJECTED
  WON
}


model Product {

  id          Int @id @default(autoincrement())

  name        String

  category    String

  price       Float

  inStock     Boolean

  description String

}